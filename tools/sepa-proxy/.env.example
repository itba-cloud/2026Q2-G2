HOST=0.0.0.0
PORT=3000

# Directorio con ZIPs de respaldo (sepa_lunes.zip ... sepa_domingo.zip) que se
# sirven cuando SEPA no responde. Por defecto es ./sepa_files junto al proyecto.
# SEPA_FALLBACK_DIR=/ruta/a/sepa_files

# Poner en true/1 para desactivar el respaldo local y que un fallo de SEPA
# siempre devuelva 502/504.
# SEPA_FALLBACK_DISABLED=false
